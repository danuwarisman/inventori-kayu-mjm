# ============================================================
# Template konfigurasi deploy MJM (Docker Compose)
#
#   cp .env.example .env
#   # lalu isi nilai aslinya
#   docker compose up -d --build
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti-password-db
POSTGRES_DB=mjm_db
POSTGRES_PORT=5432

# ---- Backend (NestJS) ----
BACKEND_PORT=3001
# Password di DATABASE_URL harus sama dengan POSTGRES_PASSWORD.
# Karakter khusus (@ : / ? #) perlu di-URL-encode.
DATABASE_URL=postgresql://postgres:ganti-password-db@db:5432/mjm_db?schema=public
# Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ---- Frontend (Next.js) ----
FRONTEND_PORT=8080
# URL backend dari dalam jaringan Docker (dipakai rewrite /api-proxy).
INTERNAL_API_URL=http://backend:3001
