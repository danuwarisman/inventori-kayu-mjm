generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 Int                  @id @default(autoincrement())
  username           String               @unique
  password           String
  nama               String
  roleId             Int
  role               Role                 @relation(fields: [roleId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  transaksiPembelian TransaksiPembelian[]
  prosesSawmill      ProsesSawmill[]
  transaksiPenjualan TransaksiPenjualan[]

  pengajuanSupplierDibuat     PengajuanPerubahanSupplier[] @relation("PengajuanSupplierPengaju")
  pengajuanSupplierDiperiksa PengajuanPerubahanSupplier[] @relation("PengajuanSupplierPemeriksa")
}

model Supplier {
  idSupplier     Int     @id @default(autoincrement()) @map("id_supplier")
  namaSupplier    String  @db.VarChar(100) @map("nama_supplier")
  alamatSupplier  String  @db.VarChar(200) @map("alamat_supplier")
  kontakSupplier  String  @db.VarChar(15) @map("kontak_supplier")

  transaksiPembelian TransaksiPembelian[]
  pengajuanPerubahan PengajuanPerubahanSupplier[]
}


model PengajuanPerubahanSupplier {
  idPengajuan    Int     @id @default(autoincrement())
  idSupplier     Int?    @map("id_supplier")
  idPengaju      Int     @map("id_pengaju")
  idPemeriksa    Int?    @map("id_pemeriksa")

  jenisAksi      JenisAksiSupplier       @map("jenis_aksi")
  namaSupplier   String                  @db.VarChar(100) @map("nama_supplier")
  alamatSupplier String                  @db.VarChar(200) @map("alamat_supplier")
  kontakSupplier String                  @db.VarChar(15)  @map("kontak_supplier")

  status         StatusPengajuanSupplier @default(MENUNGGU)
  catatan        String?                 @db.VarChar(100)
  diajukanPada   DateTime                @default(now()) @map("diajukan_pada")
  diperiksaPada  DateTime?               @map("diperiksa_pada")

  supplier Supplier? @relation(fields: [idSupplier], references: [idSupplier])
  pengaju    User  @relation("PengajuanSupplierPengaju", fields: [idPengaju], references: [id])
  pemeriksa  User? @relation("PengajuanSupplierPemeriksa", fields: [idPemeriksa], references: [id])

  @@map("pengajuan_perubahan_supplier")
}


model Customer {
  idCustomer         Int                  @id @default(autoincrement()) @map("id_customer")
  namaCustomer       String               @db.VarChar(100) @map("nama_customer")
  alamatCustomer     String               @db.VarChar(200) @map("alamat_customer")
  kontakCustomer     String               @db.VarChar(15)  @map("kontak_customer")

  transaksiPenjualan TransaksiPenjualan[]

  @@map("customer")
}

model StokLog {
  idLog        Int      @id @default(autoincrement()) @map("id_log")
  kodeLog      String?  @map("kode_log")
  idPembelian  Int?     @map("id_pembelian")
  asalSortimen String   @map("asal_sortimen")
  panjang      Decimal? @db.Decimal(10, 2)
  diameter     Decimal? @db.Decimal(10, 2)
  dimensiLog   String   @map("dimensi_log")
  volumeLog    Decimal  @db.Decimal(10, 3) @map("volume_log")
  statusLog    String   @map("status_log")
  suplier      String?  @map("suplier")
  harga        Decimal? @db.Decimal(15, 2)
  tanggalMasuk DateTime? @default(now()) @map("tanggal_masuk")

  planks             Plank[]
  detailPenjualan    DetailPenjualan[]
  transaksiPembelian TransaksiPembelian? @relation(fields: [idPembelian], references: [idPembelian])
  prosesSawmill      ProsesSawmill[]

  @@map("stok_log")
}

model TransaksiPembelian {
  idPembelian Int      @id @default(autoincrement()) @map("id_pembelian")
  idSupplier  Int      @map("id_supplier")
  idUser      Int      @map("id_user")
  tanggalBeli DateTime @db.Date @map("tanggal_beli")

  supplier Supplier @relation(fields: [idSupplier], references: [idSupplier])
  user     User     @relation(fields: [idUser], references: [id])
  stokLogs StokLog[]

  @@map("transaksi_pembelian")
}

model ProsesSawmill {
  idSawmill     Int       @id @default(autoincrement()) @map("id_sawmill")
  kodeSawmill   String?   @map("kode_sawmill")
  idLog         Int       @map("id_log")
  idUserInput   Int?      @map("id_user_input")
  tanggalProses DateTime? @default(now()) @db.Date @map("tanggal_proses")
  statusSawmill String    @db.VarChar(20) @map("status_sawmill")
  planks        Plank[]

  stokLog StokLog @relation(fields: [idLog], references: [idLog])
  user    User?   @relation(fields: [idUserInput], references: [id])

  @@map("proses_sawmill")
}

model Plank {
  idPlank         Int      @id @default(autoincrement()) @map("id_plank")
  kodePlank       String?  @map("kode_plank")
  idSawmill       Int?     @map("id_sawmill")
  idLogAsal       Int      @map("id_log_asal")
  gradePapan      String   @db.VarChar(20) @map("grade_papan")
  dimensiPlank    String   @db.VarChar(50) @map("dimensi_plank")
  tinggi          Decimal? @db.Decimal(10, 2)
  lebar           Decimal? @db.Decimal(10, 2)
  panjang         Decimal? @db.Decimal(10, 2)
  volumePlank     Decimal  @db.Decimal(10, 3) @map("volume_plank")
  stage           String?  @default("Sawmill") @db.VarChar(30)
  
  detailPalet     DetailPalet[]
  hasilDryKiln    HasilDryKiln[]
  detailPenjualan DetailPenjualan[]

  sawmill ProsesSawmill? @relation(fields: [idSawmill], references: [idSawmill])
  stokLog StokLog        @relation(fields: [idLogAsal], references: [idLog])

  @@map("plank")
}

model Palet {
  idPalet         Int      @id @default(autoincrement())
  tanggalSticking DateTime @db.Date
  statusPalet     String   @db.VarChar(20)

  detailPalet DetailPalet[]
  dryKilns    DryKiln[]
}

model DetailPalet {
  idDetailPalet Int @id @default(autoincrement())
  idPalet       Int
  idPlank       Int

  palet Palet @relation(fields: [idPalet], references: [idPalet])
  plank Plank @relation(fields: [idPlank], references: [idPlank])
}

model DryKiln {
  idOven            Int       @id @default(autoincrement()) @map("id_oven")
  idPalet           Int?      @map("id_palet")
  idPlank           Int?      @map("id_plank")
  kodeOven          String?   @map("kode_oven")
  sortimen          String?   @map("sortimen")
  grade             String?   @map("grade")
  panjang           Decimal?  @db.Decimal(10, 2)
  lebar             Decimal?  @db.Decimal(10, 2)
  tinggi            Decimal?  @db.Decimal(10, 2)
  volume            Decimal?  @db.Decimal(10, 3)
  tanggalMasuk      DateTime? @default(now()) @db.Date @map("tanggal_masuk")
  tanggalKeluar     DateTime? @db.Date @map("tanggal_keluar")
  statusPengeringan String    @default("in-drykiln") @db.VarChar(50) @map("status_pengeringan")
  stage             String?   @default("in-drykiln") @db.VarChar(50)
  kodeLog           String?   @map("kode_log")
  kodePlank         String?   @map("kode_plank")

  hasilDryKiln      HasilDryKiln[]
  palet             Palet?    @relation(fields: [idPalet], references: [idPalet])

  @@map("dry_kiln")
}

model HasilDryKiln {
  idHasilOven     Int     @id @default(autoincrement())
  idOven          Int
  idPlank         Int
  gradeAkhir      String  @db.VarChar(20)
  volumeAkhir     Decimal @db.Decimal(10, 2)
  kadarAirAkhir   Decimal @db.Decimal(5, 2)
  statusKelayakan StatusKelayakanKayu

  dryKiln DryKiln @relation(fields: [idOven], references: [idOven])
  plank   Plank   @relation(fields: [idPlank], references: [idPlank])
}

enum StatusVerifikasi {
  PENDING
  DISETUJUI
  DITOLAK
}

enum StatusPengajuanSupplier {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum JenisAksiSupplier {
  TAMBAH
  UBAH
  HAPUS
}

enum StatusKelayakanKayu {
  SIAP_JUAL
  PENGERINGAN_ULANG
}

model TransaksiPenjualan {
  idPenjualan      Int              @id @default(autoincrement()) @map("id_penjualan")
  idCustomer       Int              @map("id_customer")
  idUserInput      Int              @map("id_user_input")
  tanggalJual      DateTime         @db.Date @map("tanggal_jual")
  statusVerifikasi StatusVerifikasi @default(PENDING) @map("status_verifikasi")

  detailPenjualan DetailPenjualan[]
  customer        Customer @relation(fields: [idCustomer], references: [idCustomer])
  user            User     @relation(fields: [idUserInput], references: [id])

  @@map("transaksi_penjualan")
}

model DetailPenjualan {
  idDetail         Int     @id @default(autoincrement()) @map("id_detail")
  idPenjualan      Int     @map("id_penjualan")
  referensiBarang  String  @db.VarChar(50) @map("referensi_barang")
  idLog            Int?    @map("id_log")
  idPlank          Int?    @map("id_plank")
  kuantitasTerjual Decimal @db.Decimal(10, 2) @map("kuantitas_terjual")
  hargaSatuan      Decimal @db.Decimal(15, 2) @map("harga_satuan")

  transaksiPenjualan TransaksiPenjualan @relation(fields: [idPenjualan], references: [idPenjualan])
  stokLog            StokLog?           @relation(fields: [idLog], references: [idLog])
  plank              Plank?             @relation(fields: [idPlank], references: [idPlank])
}
