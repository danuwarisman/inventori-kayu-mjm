generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  nama      String
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  approvals Approval[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        Int      @id @default(autoincrement())
  nama      String
  alamat    String?
  telepon   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  nama      String
  alamat    String?
  telepon   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatusApprove {
  id        Int        @id @default(autoincrement())
  nama      String     @unique
  approvals Approval[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Approval {
  id              Int           @id @default(autoincrement())
  statusApproveId Int
  statusApprove   StatusApprove @relation(fields: [statusApproveId], references: [id])
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  catatan         String?
  createdAt       DateTime      @default(now())
}

model StokLog {
  idLog        Int      @id @default(autoincrement())
  idPembelian  Int
  asalSortimen String
  dimensiLog   String
  volumeLog    Decimal  @db.Decimal(10, 2)
  statusLog    String
}